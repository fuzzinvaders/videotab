# Copier en .env à côté du fichier docker-compose utilisé, puis renseigner.
# .env n'est pas suivi par git.

# --- Commun aux deux fichiers (docker-compose.yml et docker-compose.traefik.yml) ---

# Image à déployer (OPTIONNEL). Par défaut, l'image publique
# `ghcr.io/fuzzinvaders/videotab:latest` est utilisée : aucun login, rien à builder.
# Ne renseigne cette variable que pour t'en écarter — registre privé, image construite
# localement, ou tag figé plutôt que `latest` :
#   VIDEOTAB_IMAGE=ghcr.io/fuzzinvaders/videotab:1.0.0
# VIDEOTAB_IMAGE=

# Secret de signature des sessions. Recommandé : openssl rand -hex 32
# Si absent, un secret aléatoire est généré et conservé dans le volume de données ;
# le changer déconnecte tout le monde.
AUTH_SECRET=

# Taille maximale d'une vidéo envoyée, en mégaoctets. Une minute de 1080p en VP9 pèse une
# quinzaine de mégaoctets. À baisser si le disque est petit, à monter pour des morceaux longs
# en 60 images par seconde.
# VIDEO_MAX_MB=512

# Place totale accordée aux vidéos gardées sur le serveur, en mégaoctets. Sans valeur, aucun
# plafond : personne ici ne sait de quel disque tu disposes, et un chiffre inventé finirait par
# refuser un export légitime. La place occupée est affichée au bas de la bibliothèque ; le jour
# où elle t'inquiète, pose un plafond et un export de trop sera refusé avant d'être envoyé.
# VIDEOS_MAX_TOTAL_MB=

# --- docker-compose.yml (local / sans Traefik) ---

# Port exposé sur ta machine si 8080 est déjà pris par autre chose.
# HOST_PORT=8090

# Origine publique de l'app, à ne renseigner QUE si tu mets toi-même un reverse proxy devant
# ce fichier (pour un déploiement Traefik, utilise plutôt docker-compose.traefik.yml et
# DOMAIN ci-dessous, qui déduit ORIGIN tout seul). Active une vérification anti-CSRF sur les
# requêtes d'écriture. En local, laisser vide (la vérification est simplement désactivée).
# ORIGIN=https://videotab.exemple.fr

# --- docker-compose.traefik.yml (déploiement derrière Traefik) ---

# Nom d'hôte servi par Traefik. OBLIGATOIRE pour ce fichier (rien d'autre à faire pour
# ORIGIN : il est déduit automatiquement de DOMAIN).
# DOMAIN=videotab.exemple.fr
